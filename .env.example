# Copy to .env and fill in. .env is git-ignored.

# Keycard Console -> Settings -> Connection -> Issuer URL
KEYCARD_ZONE_URL=https://<your-zone-id>.keycard.cloud

# Port the MCP server listens on. The Resource Identifier in Keycard Console
# must be http://localhost:<PORT>/mcp (exactly).
PORT=8080

# --- Part 2 only (delegated access to GitHub) ---
# Keycard Console -> Applications -> <your app> -> client credentials.
# Leave blank to run Part 1 only (hello_world, no GitHub tools).
KEYCARD_CLIENT_ID=
KEYCARD_CLIENT_SECRET=

# Resource identifier of the GitHub resource you added from the catalog.
# Change only if Console shows a different identifier.
GITHUB_RESOURCE=https://api.github.com
